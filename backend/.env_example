LOG_LEVEL=DEBUG
DB_MIGRATIONS_URL = driver+psycopg://user:pass@localhost:5432/db_name
DB_URL = driver+asyncpg://user:pass@localhost:5432/db_name
DB_NAME=db_name
DB_PASSWORD=db_password
DB_USER=db_user
CONSUMER_BATCH_SIZE=10
CONSUMER_SLEEP_SECONDS=1
CONSUMER_SHUTDOWN_SECONDS=30
BOT_TOKEN="your_bot_token"  # You can get it at BotFather at Telegram

TG_PROXY_URL="socks5://ss-client:1080"  # Leave empty to disable proxy
SS_SERVER_HOST="your.vps.example.com"
SS_SERVER_PORT=8388
SS_PASSWORD="your_strong_password"
SS_METHOD="aes-256-gcm"